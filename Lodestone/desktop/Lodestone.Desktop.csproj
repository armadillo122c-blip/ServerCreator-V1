<Project Sdk="Microsoft.NET.Sdk">
  <!-- Lodestone's native window. The Python engine (../lodestone.py) still does
       the work - servers, SFTP, RCON, Discord, hosting - and this app drives it
       over its local JSON API, the same one the old browser page used. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on whatever .NET is installed, 8 or newer: a PC that only has
         .NET 9 or 10 should not need another runtime just for Lodestone. -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lodestone</AssemblyName>
    <RootNamespace>Lodestone.Desktop</RootNamespace>
    <ApplicationIcon>Assets\lodestone.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Product>Lodestone</Product>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Single-file publishes still need the native Skia/HarfBuzz libraries next
         to them unless they are extracted at run time. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.4.1" />
  </ItemGroup>
</Project>
