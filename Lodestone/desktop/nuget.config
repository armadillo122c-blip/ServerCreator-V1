<?xml version="1.0" encoding="utf-8"?>
<!-- The machine-wide NuGet.Config on this PC has no package sources at all, so
     restore finds nothing. This scopes nuget.org to this project only rather
     than changing the global config. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
